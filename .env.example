APP_NAME=DJ AI
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./dj_ai.db

# Optional LLM provider. Leave empty for mock/local-only mode.
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional video providers. Do not add keys until a provider is selected.
VIDEO_PROVIDER=mock
GEMINI_VIDEO_API_KEY=
VIDEO_PROVIDER_API_KEY=

# Media storage
MEDIA_ROOT=./storage
